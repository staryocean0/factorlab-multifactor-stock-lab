    "AccountSnapshot",
    "SelectionOpportunityLedger",
    "FactorReturnSurface",
    "RealizedPnlLedger",
    "DerivedReports"
  ],
  "stage_extensions": {
    "A0": "materialize_immutable_model_or_score_snapshot_once",
    "A1": "freeze_complete_account_family_and_cost_scenarios_before_results",
    "A2": "strategy_adapter_normalizes_account_and_ledger_core_columns",
    "A3": "validate_exact_workload_backend_and_snapshot_cache_identity",
    "A4": "blind_prior_policy_replays_once_then_materializes_complete_AccountSnapshot",
    "A5": "complete_family_replays_each_registered_account_once_and_reuses_score_market_inputs",
    "A6": "seal_account_snapshot_opportunity_ledger_factor_surface_and_realized_pnl_ledger_digests",
    "A7": "derive_all_reports_from_snapshots_and_validate_outcome_neutrally"
  },
  "account_snapshot": {
    "schema_id": "factorlab.post_training_account_research_bundle@1.0",
    "profiles": {
      "complete_account": {
        "required_for_A7_closeout": true,
        "required_files": [
          "portfolio_daily.parquet",
          "holdings.parquet",
          "trades.parquet",
          "events.parquet",
          "snapshot_manifest.json"
        ]
      },
      "account_daily_only": {
        "required_for_A7_closeout": false,
        "allowed_uses": [
          "aggregate_derived_reports",
          "runtime_benchmark"
        ],
        "may_claim_complete_trade_ledger": false
      }
    },
    "identity_columns": [
      "account_id",
      "variant_id",
      "policy_id",
      "cost_scenario_id"
    ],
    "cache_key_inputs": [
      "strategy_id",
      "model_or_score_digest",
      "account_policy_family_digest",
      "market_data_digest",
      "adapter_digest",
      "data_usage_digest",
      "formal_or_isolated_tree",
      "execution_semantics"
    ],
    "in_place_overwrite_allowed": false,
    "nav_daily_return_identity_required": true,
    "formal_isolated_scientific_bytes_required": true
  },
  "selection_opportunity_ledger": {
    "question": "did_the_frozen_score_and_policy_select_the_best_tradable_opportunities",
    "score_available_at_or_before_decision_required": true,
    "selected_asset_must_be_eligible": true,
    "hindsight_label_starts_at_or_after_decision": true,
    "hindsight_label_runtime_authority": false,
    "strategy_adapter_owns_horizon_tradability_and_opportunity_definition": true
  },
  "factor_return_surface": {
    "identity": [
      "variant_id",
      "segment_id",
      "factor_id"
    ],
    "policy_independent": true,
    "fit_once_per_variant_segment": true,
    "repeat_fit_per_year_or_account_policy_allowed": false,
    "exposure_available_at_or_before_segment_start_required": true
  },
  "realized_pnl_ledger": {
    "question": "where_did_each_account_day_stock_trade_episode_and_component_return_come_from",
    "component_ids_are_strategy_adapter_defined": true,
    "daily_simple_contribution_identity": "sum(simple_contribution)=account_daily_return",
    "daily_linked_log_identity": "sum(linked_log_contribution)=log1p(account_daily_return)",
    "transaction_cost_must_be_additive_once": true,
    "repeating_full_day_cost_on_each_trade_leg_allowed": false
  },
  "derived_reports": {
    "inputs": [
      "verified_AccountSnapshot.portfolio_daily",
      "verified_benchmark_return_series"
    ],
    "outputs": [
      "annual_relative_performance",
      "quarterly_relative_performance",
      "monthly_relative_performance"
    ],
    "model_read_count": 0,
    "score_generation_count": 0,
    "market_replay_count": 0,
    "account_replay_count": 0,
    "new_report_column_may_invalidate_account_snapshot": false
  },
  "performance_gates": {
    "cache_hit_report_p95_seconds_max": 1.0,
    "benchmark_minimum_rounds": 10,
    "benchmark_must_include_snapshot_load": true,
    "benchmark_must_include_annual_quarterly_monthly_reports": true,
    "heavy_score_matrix_rolling_regression_and_neural_inference": "GPU_first_subject_to_exact_equivalence_and_runtime_policy",
    "stable_ranking_sequential_account_and_small_report_tail": "CPU_allowed",
    "first_model_score_or_account_build_may_be_reused": true,
    "first_model_score_or_account_build_may_be_repeated_for_each_report": false
  },
  "strategy_adapter_boundary": {
    "adapter_owns": [
      "model_loading",
      "score_generation",
      "asset_universe",
      "execution_clock",
      "raw_PIT_fill",
      "corporate_action_accounting",
      "account_policy_identity",
      "factor_component_semantics",
      "opportunity_horizon"
    ],
    "project_core_owns": [
      "snapshot_schema",
      "cache_identity",
      "artifact_digests",
      "ledger_temporal_gates",
      "account_conservation",
      "period_report_math",
      "formal_isolated_replay",
      "authority_fail_closed"
    ]
  },
  "migration": {
    "sealed_strategy_results_rewritten": false,
    "old_strategy_specific_generators_deleted": false,
    "old_strategy_specific_generators_role": "historical_adapter_or_evidence",
    "next_strategy_iteration_must_use_project_bundle": true,
    "current_REAKA_model_account_or_result_changed": false
  },
